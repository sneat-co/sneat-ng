{
  "projectType": "application",
  "sourceRoot": "apps/sneat-ng-demo/src",
  "prefix": "sneat",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/apps/sneat-ng-demo"],
      "options": {
        "outputPath": "dist/apps/sneat-ng-demo",
        "index": "apps/sneat-ng-demo/src/index.html",
        "browser": "apps/sneat-ng-demo/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/sneat-ng-demo/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/sneat-ng-demo/src/favicon.ico",
          "apps/sneat-ng-demo/src/assets"
        ],
        "styles": ["apps/sneat-ng-demo/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/sneat-ng-demo/src/environments/environment.ts",
              "with": "apps/sneat-ng-demo/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "sneat-ng-demo:build:production"
        },
        "development": {
          "buildTarget": "sneat-ng-demo:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "sneat-ng-demo:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/sneat-ng-demo/**/*.ts",
          "apps/sneat-ng-demo/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/sneat-ng-demo"],
      "options": {
        "jestConfig": "apps/sneat-ng-demo/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
